<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Invisible 1px anchor moved to the touch point, so menus open where you pressed. -->
    <View
        android:id="@+id/popup_anchor"
        android:layout_width="1px"
        android:layout_height="1px"
        android:visibility="invisible" />

    <!-- Home screen, over the wallpaper. -->
    <FrameLayout
        android:id="@+id/home_content"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <!-- Clock: time over date. Tap opens the alarm/clock app. -->
            <LinearLayout
                android:id="@+id/clock"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="?android:attr/selectableItemBackground"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:paddingTop="24dp"
                android:paddingBottom="8dp">

                <TextClock
                    android:id="@+id/clock_time"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-light"
                    android:shadowColor="#99000000"
                    android:shadowRadius="8"
                    android:textColor="@color/text_primary"
                    android:textSize="64sp" />

                <TextClock
                    android:id="@+id/clock_date"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:format12Hour="EEEE, MMMM d"
                    android:format24Hour="EEEE, d MMMM"
                    android:shadowColor="#99000000"
                    android:shadowRadius="6"
                    android:textColor="@color/aquamarine"
                    android:textSize="16sp" />
            </LinearLayout>

            <com.aevrin.hearth.CellLayout
                android:id="@+id/grid"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:paddingStart="8dp"
                android:paddingTop="8dp"
                android:paddingEnd="8dp" />

            <!-- Page indicator, shown when there's more than one page. -->
            <LinearLayout
                android:id="@+id/page_dots"
                android:layout_width="match_parent"
                android:layout_height="20dp"
                android:gravity="center"
                android:orientation="horizontal"
                android:visibility="gone" />

            <!-- Dock: one row, icons only, on a translucent rounded bar. Swipe it
                 sideways when it has more than one page. -->
            <com.aevrin.hearth.CellLayout
                android:id="@+id/dock"
                android:layout_width="match_parent"
                android:layout_height="@dimen/dock_height"
                android:layout_marginStart="12dp"
                android:layout_marginEnd="12dp"
                android:paddingStart="4dp"
                android:paddingEnd="4dp" />

            <LinearLayout
                android:id="@+id/dock_dots"
                android:layout_width="match_parent"
                android:layout_height="12dp"
                android:gravity="center"
                android:orientation="horizontal"
                android:visibility="gone" />

            <ImageView
                android:id="@+id/drawer_handle"
                android:layout_width="match_parent"
                android:layout_height="28dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/open_drawer"
                android:scaleType="center"
                android:src="@drawable/ic_handle" />
        </LinearLayout>

        <TextView
            android:id="@+id/empty_hint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:padding="24dp"
            android:shadowColor="#CC000000"
            android:shadowRadius="6"
            android:text="@string/empty_hint"
            android:textColor="@color/text_primary"
            android:textSize="16sp"
            android:visibility="gone" />

        <!-- Appears while dragging: drop an icon on one of these. -->
        <LinearLayout
            android:id="@+id/drop_bar"
            android:layout_width="match_parent"
            android:layout_height="72dp"
            android:layout_gravity="top"
            android:orientation="horizontal"
            android:visibility="gone">

            <ImageView
                android:id="@+id/drop_remove"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:contentDescription="@string/remove"
                android:scaleType="center"
                android:src="@drawable/ic_drop_remove" />

            <ImageView
                android:id="@+id/drop_info"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:contentDescription="@string/app_info"
                android:scaleType="center"
                android:src="@drawable/ic_drop_info" />

            <ImageView
                android:id="@+id/drop_uninstall"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:contentDescription="@string/uninstall"
                android:scaleType="center"
                android:src="@drawable/ic_drop_uninstall" />
        </LinearLayout>
    </FrameLayout>

    <!-- App drawer: search on top, alphabetical grid below. Background opacity is a setting. -->
    <LinearLayout
        android:id="@+id/drawer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clickable="true"
        android:focusable="false"
        android:orientation="vertical"
        android:visibility="gone">

        <EditText
            android:id="@+id/search"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginStart="16dp"
            android:layout_marginTop="12dp"
            android:layout_marginEnd="16dp"
            android:layout_marginBottom="8dp"
            android:autofillHints=""
            android:background="@drawable/search_bg"
            android:hint="@string/search_hint"
            android:imeOptions="actionGo|flagNoExtractUi"
            android:importantForAutofill="no"
            android:inputType="text|textNoSuggestions"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:singleLine="true"
            android:textColor="@color/text_primary"
            android:textColorHint="@color/text_muted"
            android:textSize="16sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/drawer_list"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:clipToPadding="false"
                android:paddingStart="8dp"
                android:paddingEnd="4dp"
                android:paddingBottom="16dp"
                android:scrollbars="vertical" />

            <!-- A–Z strip: touch or slide to jump to a letter. -->
            <com.aevrin.hearth.AlphaScroller
                android:id="@+id/alpha"
                android:layout_width="24dp"
                android:layout_height="match_parent"
                android:paddingTop="8dp"
                android:paddingBottom="24dp" />
        </LinearLayout>
    </LinearLayout>

    <!-- An open folder: a compact card placed next to its icon (in code). The overlay
         itself is transparent and only catches taps outside the card to close it. -->
    <FrameLayout
        android:id="@+id/folder_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clickable="true"
        android:focusable="false"
        android:visibility="gone">

        <LinearLayout
            android:id="@+id/folder_card"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:clickable="true"
            android:elevation="8dp"
            android:orientation="vertical"
            android:padding="12dp">

            <TextView
                android:id="@+id/folder_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="?android:attr/selectableItemBackground"
                android:gravity="center"
                android:padding="8dp"
                android:textColor="@color/text_primary"
                android:textSize="20sp" />

            <!-- Scrolls only when a big folder is taller than the screen. -->
            <ScrollView
                android:id="@+id/folder_scroll"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:fadeScrollbars="false"
                android:scrollbarStyle="outsideOverlay">

                <GridLayout
                    android:id="@+id/folder_grid"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:columnCount="2" />
            </ScrollView>
        </LinearLayout>
    </FrameLayout>

</FrameLayout>
