<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Home screen, over the wallpaper. -->
    <FrameLayout
        android:id="@+id/home_content"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <!-- Clock: time over date. Tap opens the alarm/clock app. -->
            <LinearLayout
                android:id="@+id/clock"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="?android:attr/selectableItemBackground"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:paddingTop="24dp"
                android:paddingBottom="8dp">

                <TextClock
                    android:id="@+id/clock_time"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-light"
                    android:shadowColor="#99000000"
                    android:shadowRadius="8"
                    android:textColor="@color/text_primary"
                    android:textSize="64sp" />

                <TextClock
                    android:id="@+id/clock_date"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:format12Hour="EEEE, MMMM d"
                    android:format24Hour="EEEE, d MMMM"
                    android:shadowColor="#99000000"
                    android:shadowRadius="6"
                    android:textColor="@color/aquamarine"
                    android:textSize="16sp" />
            </LinearLayout>

            <com.aevrin.hearth.CellLayout
                android:id="@+id/grid"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:paddingStart="8dp"
                android:paddingTop="8dp"
                android:paddingEnd="8dp" />

            <!-- Dock: one row, icons only, on a translucent rounded bar. -->
            <com.aevrin.hearth.CellLayout
                android:id="@+id/dock"
                android:layout_width="match_parent"
                android:layout_height="@dimen/dock_height"
                android:layout_marginStart="12dp"
                android:layout_marginEnd="12dp"
                android:paddingStart="4dp"
                android:paddingEnd="4dp" />

            <ImageView
                android:id="@+id/drawer_handle"
                android:layout_width="match_parent"
                android:layout_height="28dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/open_drawer"
                android:scaleType="center"
                android:src="@drawable/ic_handle" />
        </LinearLayout>

        <TextView
            android:id="@+id/empty_hint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:padding="24dp"
            android:shadowColor="#CC000000"
            android:shadowRadius="6"
            android:text="@string/empty_hint"
            android:textColor="@color/text_primary"
            android:textSize="16sp"
            android:visibility="gone" />

        <!-- Appears while dragging a home or dock icon; drop here to unpin it. -->
        <TextView
            android:id="@+id/remove_zone"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:layout_gravity="top"
            android:background="@drawable/remove_zone_bg"
            android:gravity="center"
            android:text="@string/remove"
            android:textColor="@color/text_primary"
            android:textSize="16sp"
            android:visibility="gone" />
    </FrameLayout>

    <!-- App drawer: search on top, alphabetical grid below. Background opacity is a setting. -->
    <LinearLayout
        android:id="@+id/drawer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clickable="true"
        android:focusable="false"
        android:orientation="vertical"
        android:visibility="gone">

        <EditText
            android:id="@+id/search"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginStart="16dp"
            android:layout_marginTop="12dp"
            android:layout_marginEnd="16dp"
            android:layout_marginBottom="8dp"
            android:autofillHints=""
            android:background="@drawable/search_bg"
            android:hint="@string/search_hint"
            android:imeOptions="actionGo|flagNoExtractUi"
            android:importantForAutofill="no"
            android:inputType="text|textNoSuggestions"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:singleLine="true"
            android:textColor="@color/text_primary"
            android:textColorHint="@color/text_muted"
            android:textSize="16sp" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/drawer_list"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:paddingBottom="16dp"
            android:scrollbars="vertical" />
    </LinearLayout>

</FrameLayout>
